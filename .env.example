# FRED API key enables macroeconomic data. Add it through Replit Secrets or a local .env.
FRED_API_KEY=

# Data source
# Yahoo's GC=F gold futures quote is a proxy, not spot XAU/USD.
YAHOO_TICKER=GC=F
MARKET_PERIOD=60d
MARKET_INTERVAL=15m
MARKET_MAX_AGE_MINUTES=45
HEADLINES_PATH=news/headlines.json

# Schedule and indicators
INTERVAL_MINUTES=15
FAST_EMA_PERIOD=50
SLOW_EMA_PERIOD=200
SUPPORT_RESISTANCE_LOOKBACK=48

# Deterministic paper-trade risk controls
MAX_RISK_PER_TRADE_PCT=0.01
MAX_DAILY_DRAWDOWN_PCT=0.03
DEFAULT_STOP_LOSS_USD=8
DEFAULT_TAKE_PROFIT_USD=16
CONTRACT_SIZE_OUNCES=100
MINIMUM_LOT=0.01
LOT_STEP=0.01
MAXIMUM_LOTS=2
INITIAL_PAPER_EQUITY=10000
MINIMUM_DECISION_CONFIDENCE=0.55
MINIMUM_SIGNAL_STRENGTH=0.30
MAX_OPEN_POSITIONS=1
DATABASE_PATH=trading_bot.db
